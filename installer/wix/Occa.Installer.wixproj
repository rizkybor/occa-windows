<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    MSI for managed PCs (clubs, schools, offices), uploaded to HRIS › License Manager › Versions (BRD §4).
    Build after publishing the unpackaged app:
      dotnet publish src/Occa.App -c Release -r win-x64 -p:Platform=x64 -p:WindowsPackageType=None -o artifacts/publish/x64
      dotnet build installer/wix -c Release -p:InstallerPlatform=x64 -p:PublishDir=$(pwd)/artifacts/publish/x64 -p:ProductVersion=0.1.0
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>OCCA-$(ProductVersion)-$(InstallerPlatform)</OutputName>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)../../artifacts/publish/$(InstallerPlatform)</PublishDir>
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
