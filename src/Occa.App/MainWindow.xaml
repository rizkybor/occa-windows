<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Occa.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Occa.App"
    Title="OCCA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: project name and actions live here (FR-W1). -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/Square44x44Logo.png" Width="20" Height="20" />
                <TextBlock x:Name="AppTitleText" Text="OCCA" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="32,16,32,24" ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="NewProjectButton" Content="New project" IsEnabled="False" ToolTipService.ToolTip="Available in milestone M2" />
                <Button x:Name="OpenArchiveButton" Content="Open .occa…" Click="OpenArchive_Click" AutomationProperties.Name="Open an OCCA project file" />
                <Button x:Name="BasemapTestButton" Content="Test basemap tile" Click="BasemapTest_Click" AutomationProperties.Name="Download one Esri World Imagery tile" />
            </StackPanel>

            <ListView x:Name="ProjectList" Grid.Row="1" Margin="0,16,0,0" SelectionMode="Single" IsItemClickEnabled="True"
                      AutomationProperties.Name="Project list">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ProjectListItem">
                        <StackPanel Padding="0,8">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8A5;" FontSize="40" Opacity="0.5" />
                <TextBlock Text="No projects yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateDetail" Text="Projects you create or import appear here." Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</Window>
