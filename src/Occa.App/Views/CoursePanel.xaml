<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Occa.App.Views.CoursePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Background="{ThemeResource CpPaper2}"
    BorderBrush="{ThemeResource CpLine}"
    BorderThickness="1,0,0,0">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource CpInkMuted}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource CpInkMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource CpPaper2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="12,10" BorderBrush="{ThemeResource CpLine}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Courses" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource CpInk}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="6" AutomationProperties.Name="Close courses panel">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12,4,12,16" Spacing="6">
                <TextBlock Text="EVENT" Style="{StaticResource SectionTitle}" />
                <TextBox x:Name="EventTitleBox" PlaceholderText="Event title" LostFocus="EventFields_Changed" />
                <TextBox x:Name="OrganizerBox" PlaceholderText="Organizer" LostFocus="EventFields_Changed" />

                <TextBlock Text="COURSE" Style="{StaticResource SectionTitle}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CourseBox" HorizontalAlignment="Stretch" SelectionChanged="CourseBox_SelectionChanged" AutomationProperties.Name="Course" />
                    <Button Grid.Column="1" Click="AddCourse_Click" ToolTipService.ToolTip="Add course" AutomationProperties.Name="Add course" Padding="8,6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" x:Name="DeleteCourseButton" Click="DeleteCourse_Click" ToolTipService.ToolTip="Delete course" AutomationProperties.Name="Delete course" Padding="8,6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>
                <StackPanel x:Name="CourseFields" Spacing="6">
                    <TextBox x:Name="CourseNameBox" PlaceholderText="Course name" LostFocus="CourseFields_Changed" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="KindBox" Header="Kind" HorizontalAlignment="Stretch" SelectionChanged="CourseFields_Changed">
                            <ComboBoxItem Content="Normal" />
                            <ComboBoxItem Content="Score" />
                        </ComboBox>
                        <NumberBox Grid.Column="1" x:Name="CompetitorsBox" Header="Competitors" Minimum="0" Maximum="9999" SpinButtonPlacementMode="Compact" ValueChanged="CourseFields_Changed" />
                        <NumberBox Grid.Row="1" x:Name="ClimbBox" Header="Climb (m)" Minimum="0" Maximum="9999" SpinButtonPlacementMode="Compact" ValueChanged="CourseFields_Changed" />
                        <NumberBox Grid.Row="1" Grid.Column="1" x:Name="StartDistanceBox" Header="Timed start → triangle (m)" Minimum="0" Maximum="9999" SpinButtonPlacementMode="Compact" ValueChanged="CourseFields_Changed" />
                        <TextBox Grid.Row="2" x:Name="ClassesBox" Header="Classes" PlaceholderText="M21 W21" LostFocus="CourseFields_Changed" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FinishRouteBox" Header="Finish (16.x)" HorizontalAlignment="Stretch" SelectionChanged="CourseFields_Changed">
                            <ComboBoxItem Content="Navigate to finish" />
                            <ComboBoxItem Content="Taped route to finish" />
                            <ComboBoxItem Content="Funnel, then tapes" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="CourseStatsText" FontSize="12" Foreground="{ThemeResource CpInkMuted}" />
                </StackPanel>

                <TextBlock Text="PLACE ON MAP" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="PlaceStart" Content="Start" Click="Place_Click" ToolTipService.ToolTip="Click the map to place the start triangle" />
                    <ToggleButton x:Name="PlaceControl" Content="Control" Click="Place_Click" ToolTipService.ToolTip="Click the map to add a control (before the finish)" />
                    <ToggleButton x:Name="PlaceFinish" Content="Finish" Click="Place_Click" ToolTipService.ToolTip="Click the map to place the finish" />
                </StackPanel>
                <TextBlock Text="Drag a control to move it. Click an existing control to add it to the selected course." FontSize="11" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap" />

                <TextBlock Text="CONTROLS" Style="{StaticResource SectionTitle}" />
                <ListView x:Name="ControlsList" MaxHeight="220" SelectionMode="Single" SelectionChanged="ControlsList_SelectionChanged" BorderBrush="{ThemeResource CpLine}" BorderThickness="1" CornerRadius="6">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource CpInkMuted}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="MoveUpButton" Click="MoveUp_Click" ToolTipService.ToolTip="Earlier in the course" Padding="8,6"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                    <Button x:Name="MoveDownButton" Click="MoveDown_Click" ToolTipService.ToolTip="Later in the course" Padding="8,6"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                    <Button x:Name="RemoveFromCourseButton" Content="Remove from course" Click="RemoveFromCourse_Click" />
                    <Button x:Name="DeleteControlButton" Click="DeleteControl_Click" ToolTipService.ToolTip="Delete the control from all courses" Padding="8,6"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                </StackPanel>
                <Button Content="Renumber codes" Click="Renumber_Click" />

                <StackPanel x:Name="ControlFields" Spacing="6">
                    <TextBlock Text="CONTROL DESCRIPTION (IOF 2024)" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="CodeBox" Header="Code (31–255)" Minimum="31" Maximum="255" SpinButtonPlacementMode="Compact" ValueChanged="ControlFields_Changed" />
                        <NumberBox Grid.Column="1" x:Name="SizeBox" Header="Symbol size (%)" Minimum="50" Maximum="200" SpinButtonPlacementMode="Compact" ValueChanged="ControlFields_Changed" />
                    </Grid>
                    <ComboBox x:Name="WhichBox" Header="C · Which" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                    <ComboBox x:Name="FeatureBox" Header="D · Feature" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                    <ComboBox x:Name="AppearanceBox" Header="E · Appearance" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DimensionBox" Header="F · Dimensions" PlaceholderText="1.5, 8x4, 0.5/3" LostFocus="ControlFields_Changed" />
                        <ComboBox Grid.Column="1" x:Name="CombinationBox" Header="F · Combination" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LocationBox" Header="G · Flag location" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                        <ComboBox Grid.Column="1" x:Name="DirectionBox" Header="Direction" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                    </Grid>
                    <ComboBox x:Name="OtherBox" Header="H · Other" HorizontalAlignment="Stretch" SelectionChanged="ControlFields_Changed" />
                    <TextBlock x:Name="DescriptionText" FontSize="12" Foreground="{ThemeResource CpInk}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="PRINT LAYOUT" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="DescriptionOnMapCheck" Content="Control descriptions on the map" Click="Layout_Changed" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CornerBox" Header="Corner" HorizontalAlignment="Stretch" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="Top left" />
                        <ComboBoxItem Content="Top right" />
                        <ComboBoxItem Content="Bottom left" />
                        <ComboBoxItem Content="Bottom right" />
                    </ComboBox>
                    <NumberBox Grid.Column="1" x:Name="CellBox" Header="Cell (mm, 5–7)" Minimum="5" Maximum="7" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="Layout_Changed" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DescriptionStyleBox" Header="Style" HorizontalAlignment="Stretch" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="IOF symbols" />
                        <ComboBoxItem Content="Text" />
                    </ComboBox>
                    <NumberBox Grid.Column="1" x:Name="MaxRowsBox" Header="Rows per column (0 = all)" Minimum="0" Maximum="40" SpinButtonPlacementMode="Compact" ValueChanged="Layout_Changed" />
                </Grid>
                <CheckBox x:Name="SeparatePageCheck" Content="Also a separate description page" Click="Layout_Changed" />
                <CheckBox x:Name="PurpleDescriptionCheck" Content="Purple descriptions (like the controls)" Click="Layout_Changed" />

                <TextBlock Text="TOOLS" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Import course…" Click="Import_Click" ToolTipService.ToolTip=".occa, OCAD course setting (.ocd), OOM (.omap/.xmap)" />
                    <Button Content="IOF XML…" Click="ExportIof_Click" ToolTipService.ToolTip="Export courses as IOF XML 3.0 CourseData" />
                    <Button Content="Check" Click="Check_Click" ToolTipService.ToolTip="Course check (like Purple Pen's report)" />
                </StackPanel>
                <TextBlock x:Name="WarningsText" FontSize="12" Foreground="{ThemeResource CpRoseStrong}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
