<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Occa.App.Views.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export"
    PrimaryButtonText="Export"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="420">
        <TextBlock Text="Format" FontWeight="SemiBold" />
        <RadioButtons x:Name="FormatButtons" SelectedIndex="0" MaxColumns="3">
            <RadioButton Content="PDF (CMYK, georeferenced)" />
            <RadioButton Content="PNG + world file" />
            <RadioButton Content="TIFF + world file" />
            <RadioButton Content="JPEG + world file" />
            <RadioButton Content="OpenOrienteering (.omap)" />
            <RadioButton Content="DXF (R12)" />
        </RadioButtons>
        <StackPanel x:Name="DpiRow" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Resolution" VerticalAlignment="Center" />
            <ComboBox x:Name="DpiBox" SelectedIndex="0">
                <ComboBoxItem Content="300 dpi" />
                <ComboBoxItem Content="600 dpi" />
                <ComboBoxItem Content="900 dpi" />
            </ComboBox>
        </StackPanel>
        <TextBlock Text="File name" FontWeight="SemiBold" />
        <TextBox x:Name="FileNameBox" />
        <TextBlock Text="Location" FontWeight="SemiBold" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Choose…" Click="ChooseFolder_Click" />
        </Grid>
        <CheckBox x:Name="GridCheck" Content="Include north lines" />
    </StackPanel>
</ContentDialog>
