<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Occa.App.Views.LicenseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="License"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!-- No fixed height: the dialog is capped by the window (ContentDialogMaxHeight) and this ScrollViewer scrolls. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Spacing="14" MinWidth="500" MaxWidth="540">
            <InfoBar x:Name="LockedNotice" IsOpen="False" IsClosable="False" Severity="Informational" />
            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Severity="Informational" />

            <!-- YOUR PLAN -->
            <Border CornerRadius="12" Background="{ThemeResource CpPaper}" BorderBrush="{ThemeResource CpLine}" BorderThickness="1" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="YOUR PLAN" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CpInkMuted}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border x:Name="PlanBadge" CornerRadius="{StaticResource CpRadiusChip}" Background="{ThemeResource CpSandFill}" BorderBrush="{ThemeResource CpSandBorder}" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock x:Name="PlanText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CpSandStrong}" />
                        </Border>
                        <TextBlock x:Name="PlanSubtitle" FontSize="13" Foreground="{ThemeResource CpInkMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid x:Name="StatsGrid" ColumnSpacing="10" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="Stat1" FontSize="12" Foreground="{ThemeResource CpInk}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Stat2" Grid.Column="1" FontSize="12" Foreground="{ThemeResource CpInk}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Stat3" Grid.Row="1" FontSize="12" Foreground="{ThemeResource CpInk}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Stat4" Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{ThemeResource CpInk}" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel x:Name="SeatActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckButton" Content="Check now" Click="Check_Click" ToolTipService.ToolTip="Ask the License Manager again (also restores a license after a reinstall)" />
                        <Button x:Name="ReleaseButton" Content="Release this PC" Click="Release_Click" ToolTipService.ToolTip="Free this PC's seat so the key can be used on another device" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock x:Name="DevicesText" FontSize="12" Foreground="{ThemeResource CpInkMuted}" />
                </StackPanel>
            </Border>

            <!-- LICENSE KEY -->
            <Border x:Name="KeyCard" CornerRadius="12" Background="{ThemeResource CpPaper}" BorderBrush="{ThemeResource CpLine}" BorderThickness="1" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="LICENSE KEY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CpInkMuted}" />
                    <TextBlock Text="Paste the key from your License Certificate. It starts with OC7 and the plan number." FontSize="12" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyBox" PlaceholderText="OC72-XXXX-XXXX-XXXX-0001" FontFamily="Consolas" CharacterCasing="Upper" MaxLength="24" TextChanged="KeyBox_TextChanged" KeyDown="KeyBox_KeyDown" AutomationProperties.Name="License key" />
                        <Button Grid.Column="1" x:Name="ActivateButton" Style="{StaticResource CpPrimaryButton}" Content="Activate" Click="Activate_Click" IsEnabled="False" />
                    </Grid>
                    <TextBlock x:Name="KeyHint" FontSize="12" Foreground="{ThemeResource CpInkMuted}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap">
                        <Run Text="By activating, you agree to the" />
                        <Hyperlink Click="Terms_Click"><Run Text="OCCA License Terms" /></Hyperlink><Run Text="." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- PLANS -->
            <TextBlock Text="PLANS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CpInkMuted}" />
            <StackPanel x:Name="PlansPanel" Spacing="8" />

            <!-- FEATURES -->
            <TextBlock Text="EVERY LICENSE KEY INCLUDES" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CpInkMuted}" />
            <StackPanel x:Name="FeaturesPanel" Spacing="6" />
            <Border CornerRadius="10" Background="{ThemeResource CpPaper2}" Padding="12">
                <TextBlock Text="Your projects always stay yours: on Starter, everything still opens and exports to PDF." FontSize="12" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="2">
                <TextBlock Text="License keys by Jendela Cakra Digital · one back office for Mac, iPad and Windows." FontSize="11" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap" />
                <TextBlock x:Name="DeviceText" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource CpInkMuted}" IsTextSelectionEnabled="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
