<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Occa.App.Views.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New project"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="440">
        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Taman Kota Sprint" TextChanged="NameBox_TextChanged" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ScaleBox" Header="Scale" HorizontalAlignment="Stretch" SelectionChanged="ScaleBox_SelectionChanged" />
            <ComboBox Grid.Column="1" x:Name="OrientationBox" Header="A4 sheet" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Portrait" />
                <ComboBoxItem Content="Landscape" />
            </ComboBox>
        </Grid>
        <TextBlock x:Name="StandardText" FontSize="12" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap" />
        <TextBlock Text="Start location" FontWeight="SemiBold" />
        <TextBlock Text="The map opens here in Select Area mode: pan the satellite image under the A4 frame, then lock the area. Latitude and longitude in decimal degrees (WGS84), e.g. from Google Maps." FontSize="12" Foreground="{ThemeResource CpInkMuted}" TextWrapping="Wrap" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LatBox" Header="Latitude" PlaceholderText="-6.1754" TextChanged="NameBox_TextChanged" />
            <TextBox Grid.Column="1" x:Name="LonBox" Header="Longitude" PlaceholderText="106.8272" TextChanged="NameBox_TextChanged" />
        </Grid>
        <TextBlock x:Name="ZoneText" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource CpInkMuted}" />
        <TextBlock x:Name="LimitText" FontSize="12" Foreground="{ThemeResource CpRoseStrong}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
