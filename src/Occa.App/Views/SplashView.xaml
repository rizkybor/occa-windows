<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Occa.App.Views.SplashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Occa.App.Controls"
    Background="{ThemeResource CpPaper}">

    <UserControl.Resources>
        <Storyboard x:Name="Intro">
            <!-- Contours fade in and settle (1.2 s). -->
            <DoubleAnimation Storyboard.TargetName="Contours" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContourScale" Storyboard.TargetProperty="ScaleX" From="1.06" To="1" Duration="0:0:1.2" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContourScale" Storyboard.TargetProperty="ScaleY" From="1.06" To="1" Duration="0:0:1.2" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Logo settles in (spring-like, 0.15 s delay). -->
            <DoubleAnimation Storyboard.TargetName="Logo" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.15" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From="0.86" To="1" BeginTime="0:0:0.15" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From="0.86" To="1" BeginTime="0:0:0.15" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Name, tagline and credits (0.55 s delay). -->
            <DoubleAnimation Storyboard.TargetName="TextBlock" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="TextOffset" Storyboard.TargetProperty="Y" From="8" To="0" BeginTime="0:0:0.55" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Credits" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.5" />
            <!-- The pen stroke draws slowly and finishes at 3.5 s (0.75 s delay + 2.75 s). -->
            <DoubleAnimation Storyboard.TargetName="StrokeClipScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" BeginTime="0:0:0.75" Duration="0:0:2.75" EnableDependentAnimation="True">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="Outro" Completed="Outro_Completed">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{ThemeResource CpPaper}" SizeChanged="Root_SizeChanged">
        <controls:SplashContours x:Name="Contours" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <controls:SplashContours.RenderTransform>
                <ScaleTransform x:Name="ContourScale" />
            </controls:SplashContours.RenderTransform>
        </controls:SplashContours>

        <StackPanel x:Name="Centre" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="Logo" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" />
                </Border.RenderTransform>
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Border x:Name="LogoFrame" Width="200" Height="200" CornerRadius="44">
                    <Image Source="ms-appx:///Assets/AppLogo.png" Stretch="Uniform" />
                </Border>
            </Border>

            <StackPanel x:Name="TextBlock" Opacity="0" HorizontalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="TextOffset" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="Title" Text="OCCA" FontWeight="SemiBold" CharacterSpacing="150" HorizontalAlignment="Center"
                           Foreground="{ThemeResource CpSplashTitle}" />
                <Path x:Name="PenStroke" Stroke="{ThemeResource CpOrange}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center">
                    <Path.Clip>
                        <RectangleGeometry x:Name="StrokeClip">
                            <RectangleGeometry.Transform>
                                <ScaleTransform x:Name="StrokeClipScale" ScaleX="0" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </Path.Clip>
                </Path>
                <TextBlock x:Name="Tagline" Text="ORIENTEERING CAKRA CAD APPLICATION" FontWeight="Medium" CharacterSpacing="80"
                           HorizontalAlignment="Center" Foreground="{ThemeResource CpSplashMuted}" Opacity="{ThemeResource CpSplashTaglineOpacity}" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="Credits" Opacity="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="6">
            <TextBlock x:Name="VersionText" FontFamily="Consolas" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{ThemeResource CpSplashMuted}" />
            <TextBlock Text="Supported by" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{ThemeResource CpSplashMuted}" Margin="0,8,0,0" />
            <Image x:Name="JcdLogo" Source="{ThemeResource JcdLogoImage}" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
